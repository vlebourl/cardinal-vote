# Cardinal Vote Generalized Voting Platform
# Environment Configuration Example

# === Core Configuration ===
# Application name displayed in UI
APP_NAME="Generalized Voting Platform"

# Application version
APP_VERSION="1.2.2"

# Debug mode (set to false in production)
DEBUG=false

# Host and port configuration
HOST=0.0.0.0
PORT=8000

# === Database Configuration ===
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://username:password@postgres:5432/database_name

# === Authentication & Security ===
# Admin credentials (required for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure-password-here

# Session secret key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET_KEY=your-secret-key-here

# JWT secret key for API tokens
JWT_SECRET_KEY=your-jwt-secret-here

# Super admin email
SUPER_ADMIN_EMAIL=admin@your-domain.com

# === Email Configuration ===
# Email backend: 'mock' (logs to console) or 'smtp' (real emails)
EMAIL_BACKEND=mock

# SMTP Configuration (required if EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password

# From email address for system emails
FROM_EMAIL=noreply@your-domain.com

# === CAPTCHA Configuration ===
# CAPTCHA backend: 'mock', 'recaptcha', or 'hcaptcha'
CAPTCHA_BACKEND=mock

# Google reCAPTCHA v2 (if CAPTCHA_BACKEND=recaptcha)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# hCAPTCHA (if CAPTCHA_BACKEND=hcaptcha)
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# === File Upload Configuration ===
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Allowed file extensions for vote option content
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,md

# Upload directory path
UPLOAD_DIR=./uploads

# === Rate Limiting ===
# Rate limit for API endpoints (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# === CORS Configuration ===
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# === Logging Configuration ===
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/app.log

# === Redis Configuration (optional, for caching) ===
# REDIS_URL=redis://localhost:6379/0

# === Production Security Headers ===
# HSTS max age in seconds (31536000 = 1 year)
HSTS_MAX_AGE=31536000

# CSP report URI (optional)
# CSP_REPORT_URI=https://your-domain.com/csp-report

# === Development Tools ===
# Enable SQL echo for debugging (never use in production)
SQL_ECHO=false

# Enable profiling
ENABLE_PROFILING=false

# === Email Configuration ===
# Email backend: 'mock' for development, 'smtp' for production
EMAIL_BACKEND=mock

# SMTP settings (required when EMAIL_BACKEND=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@your-domain.com

# Public URL for email links (customize for your domain)
# Used in password reset emails and other email links
PUBLIC_URL=http://localhost:8000
